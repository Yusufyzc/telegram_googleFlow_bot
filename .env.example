# ════════════════════════════════════════════════════════════════════════════
# .env.example — Ortam değişkenleri şablonu
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
# ════════════════════════════════════════════════════════════════════════════

# ── Telegram Bot Token ───────────────────────────────────────────────────────
# @BotFather'dan alınan bot token'ı
TELEGRAM_BOT_TOKEN=1234567890:AABBCCDDEEFFaabbccddeeff1234567890

# ── Yetkili Kullanıcılar ─────────────────────────────────────────────────────
# Botu kullanabilecek Telegram User ID'leri (virgülle ayrılmış)
# ID bulmak için: @userinfobot'a mesaj atın
ALLOWED_USER_IDS=123456789,987654321

# ── Fernet Şifreleme Anahtarı ────────────────────────────────────────────────
# Kullanıcı çerezlerini şifrelemek için kullanılır.
# Yeni anahtar üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here_44_chars_base64==

# ── Google Flow Proje ID ─────────────────────────────────────────────────────
# labs.google/fx/tools/flow/project/{PROJECT_ID} URL'sinden alınır.
# flow login yapıp: flow projects komutu ile de görülebilir.
FLOW_PROJECT_ID=your-flow-project-uuid-here

# ── Veritabanı Yolu (isteğe bağlı) ──────────────────────────────────────────
# Docker volume içinde kalıcı olarak saklanır.
DB_PATH=/data/bot.db

# ── Video Zaman Aşımı (isteğe bağlı) ────────────────────────────────────────
# Saniye cinsinden — T2V + Extend toplam bekleme süresi
VIDEO_TIMEOUT_S=360

# ── Geçici Dosya Dizini (isteğe bağlı) ──────────────────────────────────────
# Üretilen videolar gönderilmeden önce burada tutulur, sonra silinir.
TEMP_DIR=/tmp/flow_videos